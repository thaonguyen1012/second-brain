# Copy to backend/.env (gitignored) and adjust.
DEBUG=true
SECRET_KEY=change-me-dev-only
DATABASE_URL=postgres://alex_brain:alex_brain@localhost:5432/alex_brain
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8080
# dev: trust DEV_USER_EMAIL without login (refused unless DEBUG=true). Production: cf_access.
AUTH_MODE=dev
DEV_USER_EMAIL=dev@localhost
OWNER_EMAIL=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
LOG_LEVEL=INFO
# Inbox thumbnails written by run_jobs (default backend/media/thumbs, gitignored).
# THUMBS_DIR=/srv/alex-brain/thumbs
# LLM (DECISIONS 10.4): provider gemini (free tier for now) or anthropic (not implemented yet).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
LLM_MONTHLY_BUDGET_USD=5
LLM_FREE_TIER=true  # Gemini free tier: record cost 0 (the budget guard still counts paid prices)
