{
  "name": "web",
  "version": "0.0.52",
  "private": true,
  "scripts": {
    "build": "next build && node scripts/postbuild-standalone.mjs",
    "dev": "next dev",
    "start": "CONTENT_DIR=${CONTENT_DIR:-$PWD/content/docs} SEARCH_DB=${SEARCH_DB:-$PWD/data/search.sqlite} PORT=${PORT:-3000} node .next/standalone/server.js",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "export:static": "STATIC_EXPORT=1 next build",
    "predev": "node scripts/prepare-vendor.mjs",
    "prebuild": "node scripts/prepare-vendor.mjs",
    "search:rebuild": "node scripts/build-search.mjs",
    "assets:prepare": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@fumadocs/mdx-remote": "^1.5.3",
    "cn": "^0.5.0",
    "fumadocs-core": "16.17.9",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.9",
    "github-slugger": "^2.0.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "adm-zip": "^0.6.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.31",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
