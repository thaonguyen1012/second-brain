# Alex's Brain (systemd): /etc/brain/backend.env, owned by root, mode 0600 (deploy/README.md, "systemd").
# systemd passes it to the Django-side units (EnvironmentFile) before dropping to brain, which cannot read it.
# Values marked <...> are yours to fill in.
DEBUG=false
SECRET_KEY=<python3.13 -c "import secrets; print(secrets.token_urlsafe(50))">
DATABASE_URL=postgres://brain:<the role's password>@127.0.0.1:5433/alex_brain
ALLOWED_HOSTS=brain.example.com
CSRF_TRUSTED_ORIGINS=https://brain.example.com
AUTH_MODE=cf_access
OWNER_EMAIL=<the email the Access policy allows>
CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
CF_ACCESS_AUD=<the Access application's AUD tag>
LOG_LEVEL=INFO
CONTENT_DIR=/srv/brain/content
FILES_DIR=/srv/brain/files
THUMBS_DIR=/srv/brain/thumbs
STATIC_ROOT=/srv/brain/staticfiles
BACKUP_DIR=/srv/brain/backups
BACKUP_KEEP=14
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=<the key>
LLM_MONTHLY_BUDGET_USD=5
LLM_FREE_TIER=true
BRIEF_FETCH_HOURS=6,12,18
BRIEF_BUILD_TIME=06:30
BRIEF_WAIT_UNTIL=09:00
BRIEF_TAG_DAILY_CAP=40
BRIEF_MAX_ITEMS=8
BRIEF_MAX_AGE_HOURS=48
BRIEF_INTRO=true
